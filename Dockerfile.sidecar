# ---- Build stage ----
FROM golang:1.25-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /backuparr-sidecar ./cmd/sidecar

# ---- Runtime stage ----
FROM debian:trixie-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        sqlite3 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /backuparr-sidecar /usr/local/bin/backuparr-sidecar

# Fixed UID/GID (not shared with the backuparr/web images) so operators can
# pre-chown the mounted BACKUP_PATH volume to a known, stable ID. Restore
# extracts archive-supplied files into that volume, so it must be writable by
# this UID (or group-writable with this GID). The Docker-socket restart path
# (DOCKER_CONTAINER) additionally needs the socket accessible to this user —
# e.g. `docker run --group-add "$(stat -c %g /var/run/docker.sock)"` — since
# the host's docker group GID isn't known at image build time; the Kubernetes
# restart path uses the in-cluster service-account token and needs no
# additional access.
RUN groupadd -g 10001 backuparr && \
    useradd -u 10001 -g backuparr -d /nonexistent -s /usr/sbin/nologin backuparr

EXPOSE 8484
USER backuparr
ENTRYPOINT ["backuparr-sidecar"]
